# Optional local-only browser API origin. No credentials are required in Phase 1.
VITE_API_URL=http://localhost:8000
ARGUS_ENV=development
# Local-only example. Change the password before using outside an isolated workstation.
ARGUS_DATABASE_URL=postgresql+psycopg://argus:argus_local_only@localhost:5432/argus
# Optional private raw-artifact directory for official Treasury CSV payloads.
ARGUS_ARTIFACT_DIR=.argus-artifacts
# Identify scheduled requests; deployments should include a monitored contact route.
ARGUS_USER_AGENT=ARGUS/0.2
